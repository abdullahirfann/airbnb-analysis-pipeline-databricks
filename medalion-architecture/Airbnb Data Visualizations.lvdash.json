{
  "datasets": [
    {
      "name": "efdda21c",
      "displayName": "top_10_hosts_by_listings",
      "queryLines": [
        "SELECT\n",
        "  name,\n",
        "  listing_count\n",
        "FROM airbnb_host_listing_counts_gold\n",
        "ORDER BY listing_count DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "b72f3ec4",
      "displayName": "top_10_hosts_by_revenue",
      "queryLines": [
        "SELECT\n",
        "  name,\n",
        "  CAST(REPLACE(total_revenue, '$', '') AS DOUBLE) AS revenue\n",
        "FROM airbnb_hosts_revenue_gold\n",
        "ORDER BY revenue DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "53e12a71",
      "displayName": "top_10_hosts_by_reviews",
      "queryLines": [
        "SELECT\n",
        "  name,\n",
        "  average_rating\n",
        "FROM airbnb_hosts_reviews_gold\n",
        "ORDER BY average_rating DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "ff2fb884",
      "displayName": "airbnb_city_ratings_gold",
      "queryLines": [
        "SELECT\n",
        "  country,\n",
        "  city,\n",
        "  COALESCE(average_rating, 0) AS average_rating\n",
        "FROM airbnb_city_ratings_gold\n",
        "ORDER BY average_rating DESC\n"
      ]
    },
    {
      "name": "bc5d4538",
      "displayName": "airbnb_neighbourhood_ratings_gold",
      "queryLines": [
        "SELECT\n",
        "  country,\n",
        "  city,\n",
        "  neighbourhood,\n",
        "  avg_reviews\n",
        "FROM airbnb_neighbourhood_ratings_gold\n",
        "WHERE avg_reviews IS NOT NULL\n",
        "ORDER BY avg_reviews DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "bf08ba63",
      "displayName": "airbnb_listing_skew_gold",
      "queryLines": [
        "SELECT\n",
        "  host_name,\n",
        "  listing_name,\n",
        "  listing_review,\n",
        "  user_reviews_avg,\n",
        "  skew\n",
        "FROM airbnb_listing_skew_gold\n",
        "WHERE skew IS NOT NULL\n",
        "ORDER BY ABS(skew) DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "67c57081",
      "displayName": "airbnb_reviews_gold",
      "queryLines": [
        "SELECT\n",
        "  sentiment,\n",
        "  COUNT(*) AS review_count\n",
        "FROM airbnb_reviews_gold\n",
        "GROUP BY sentiment\n",
        "ORDER BY review_count DESC\n"
      ]
    },
    {
      "name": "5f7f1a2c",
      "displayName": "airbnb_reviews_gold 1",
      "queryLines": [
        "SELECT\n",
        "  category,\n",
        "  COUNT(*) AS category_count\n",
        "FROM (\n",
        "  SELECT explode(review_categories) AS category\n",
        "  FROM airbnb_reviews_gold\n",
        ")\n",
        "GROUP BY category\n",
        "ORDER BY category_count DESC\n",
        "LIMIT 10\n"
      ]
    },
    {
      "name": "36f6fddd",
      "displayName": "revenue_vs_rating",
      "queryLines": [
        "SELECT\n",
        "  l.id,\n",
        "  l.name,\n",
        "  l.review_scores_rating,\n",
        "  l.estimated_revenue\n",
        "FROM airbnb_listings_silver l\n",
        "WHERE review_scores_rating IS NOT NULL\n",
        "  AND estimated_revenue IS NOT NULL\n"
      ]
    },
    {
      "name": "d009df23",
      "displayName": "reviews_vs_rating",
      "queryLines": [
        "SELECT\n",
        "  reviews_per_month,\n",
        "  review_scores_rating\n",
        "FROM airbnb_listings_silver\n",
        "WHERE reviews_per_month IS NOT NULL\n",
        "  AND review_scores_rating IS NOT NULL\n"
      ]
    }
  ],
